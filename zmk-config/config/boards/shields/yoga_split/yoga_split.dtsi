#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &yoga_split_layout;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8)
        >;
    };

    yoga_split_layout: yoga_split_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        keys  //                     w   h     x     y   rot    rx    ry
            = <&key_physical_attrs 100 100     0    50     0    50   100>
            , <&key_physical_attrs 100 100   100    50     0   150   100>
            , <&key_physical_attrs 100 100   200    17     0   250    67>
            , <&key_physical_attrs 100 100   300     0     0   350    50>
            , <&key_physical_attrs 100 100   400    17     0   450    67>
            , <&key_physical_attrs 100 100   500    33     0   550    83>
            , <&key_physical_attrs 100 100   956    33     0  1006    83>
            , <&key_physical_attrs 100 100  1056    17     0  1106    67>
            , <&key_physical_attrs 100 100  1156     0     0  1206    50>
            , <&key_physical_attrs 100 100  1256    17     0  1306    67>
            , <&key_physical_attrs 100 100  1356    50     0  1406   100>
            , <&key_physical_attrs 100 100  1456    50     0  1506   100>
            , <&key_physical_attrs 100 100     0   144     0    50   194>
            , <&key_physical_attrs 100 100   100   144     0   150   194>
            , <&key_physical_attrs 100 100   200   111     0   250   161>
            , <&key_physical_attrs 100 100   300    94     0   350   144>
            , <&key_physical_attrs 100 100   400   111     0   450   161>
            , <&key_physical_attrs 100 100   500   128     0   550   178>
            , <&key_physical_attrs 100 100   956   128     0  1006   178>
            , <&key_physical_attrs 100 100  1056   111     0  1106   161>
            , <&key_physical_attrs 100 100  1156    94     0  1206   144>
            , <&key_physical_attrs 100 100  1256   111     0  1306   161>
            , <&key_physical_attrs 100 100  1356   144     0  1406   194>
            , <&key_physical_attrs 100 100  1456   144     0  1506   194>
            , <&key_physical_attrs 100 100     0   239     0    50   289>
            , <&key_physical_attrs 100 100   100   239     0   150   289>
            , <&key_physical_attrs 100 100   200   206     0   250   256>
            , <&key_physical_attrs 100 100   300   189     0   350   239>
            , <&key_physical_attrs 100 100   400   206     0   450   256>
            , <&key_physical_attrs 100 100   500   222     0   550   272>
            , <&key_physical_attrs 100 100   956   222     0  1006   272>
            , <&key_physical_attrs 100 100  1056   206     0  1106   256>
            , <&key_physical_attrs 100 100  1156   189     0  1206   239>
            , <&key_physical_attrs 100 100  1256   206     0  1306   256>
            , <&key_physical_attrs 100 100  1356   239     0  1406   289>
            , <&key_physical_attrs 100 100  1456   239     0  1506   289>
            , <&key_physical_attrs 100 100     0   333     0    50   383>
            , <&key_physical_attrs 100 100   100   333     0   150   383>
            , <&key_physical_attrs 100 100   200   300     0   250   350>
            , <&key_physical_attrs 100 100   300   283     0   350   333>
            , <&key_physical_attrs 100 100   400   300     0   450   350>
            , <&key_physical_attrs 100 100   500   317     0   550   367>
            , <&key_physical_attrs 100 100   956   317     0  1006   367>
            , <&key_physical_attrs 100 100  1056   300     0  1106   350>
            , <&key_physical_attrs 100 100  1156   283     0  1206   333>
            , <&key_physical_attrs 100 100  1256   300     0  1306   350>
            , <&key_physical_attrs 100 100  1356   333     0  1406   383>
            , <&key_physical_attrs 100 100  1456   333     0  1506   383>
            , <&key_physical_attrs 100 100   378   408     0   428   458>
            , <&key_physical_attrs 100 100   485   418  1000   535   468>
            , <&key_physical_attrs 100 100   589   446  2000   639   496>
            , <&key_physical_attrs 100 100   866   446 -2000   916   496>
            , <&key_physical_attrs 100 100   970   418 -1000  1020   468>
            , <&key_physical_attrs 100 100  1078   408     0  1128   458>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
