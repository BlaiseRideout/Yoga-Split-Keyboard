#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &yoga3_mono_layout;
    };

    // 42 keys in a 6 x 7 matrix: left rows 0-2, right rows 3-5, thumbs in column 6
    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(5,5) RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)
            RC(0,6) RC(1,6) RC(2,6) RC(5,6) RC(4,6) RC(3,6)
        >;
    };

    yoga3_mono_layout: yoga3_mono_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        keys  //                     w   h     x     y   rot    rx    ry
            = <&key_physical_attrs 100 100      33       0    1000      83      50>
            , <&key_physical_attrs 100 100     131      17    1000     181      67>
            , <&key_physical_attrs 100 100     236       2    1000     286      52>
            , <&key_physical_attrs 100 100     337       3    1000     387      53>
            , <&key_physical_attrs 100 100     433      37    1000     483      87>
            , <&key_physical_attrs 100 100     528      70    1000     578     120>
            , <&key_physical_attrs 100 100     961      70 (-1000)    1011     120>
            , <&key_physical_attrs 100 100    1056      37 (-1000)    1106      87>
            , <&key_physical_attrs 100 100    1152       3 (-1000)    1202      53>
            , <&key_physical_attrs 100 100    1253       2 (-1000)    1303      52>
            , <&key_physical_attrs 100 100    1358      17 (-1000)    1408      67>
            , <&key_physical_attrs 100 100    1456       0 (-1000)    1506      50>
            , <&key_physical_attrs 100 100      16      93    1000      66     143>
            , <&key_physical_attrs 100 100     115     110    1000     165     160>
            , <&key_physical_attrs 100 100     219      95    1000     269     145>
            , <&key_physical_attrs 100 100     321      96    1000     371     146>
            , <&key_physical_attrs 100 100     416     130    1000     466     180>
            , <&key_physical_attrs 100 100     512     163    1000     562     213>
            , <&key_physical_attrs 100 100     977     163 (-1000)    1027     213>
            , <&key_physical_attrs 100 100    1073     130 (-1000)    1123     180>
            , <&key_physical_attrs 100 100    1168      96 (-1000)    1218     146>
            , <&key_physical_attrs 100 100    1270      95 (-1000)    1320     145>
            , <&key_physical_attrs 100 100    1374     110 (-1000)    1424     160>
            , <&key_physical_attrs 100 100    1472      93 (-1000)    1522     143>
            , <&key_physical_attrs 100 100       0     186    1000      50     236>
            , <&key_physical_attrs 100 100      98     203    1000     148     253>
            , <&key_physical_attrs 100 100     203     188    1000     253     238>
            , <&key_physical_attrs 100 100     304     189    1000     354     239>
            , <&key_physical_attrs 100 100     400     223    1000     450     273>
            , <&key_physical_attrs 100 100     495     256    1000     545     306>
            , <&key_physical_attrs 100 100     994     256 (-1000)    1044     306>
            , <&key_physical_attrs 100 100    1089     223 (-1000)    1139     273>
            , <&key_physical_attrs 100 100    1185     189 (-1000)    1235     239>
            , <&key_physical_attrs 100 100    1286     188 (-1000)    1336     238>
            , <&key_physical_attrs 100 100    1390     203 (-1000)    1440     253>
            , <&key_physical_attrs 100 100    1489     186 (-1000)    1539     236>
            , <&key_physical_attrs 100 100     359     325    1000     409     375>
            , <&key_physical_attrs 100 100     463     353    2000     513     403>
            , <&key_physical_attrs 100 100     561     399    3000     611     449>
            , <&key_physical_attrs 100 100     928     399 (-3000)     978     449>
            , <&key_physical_attrs 100 100    1026     353 (-2000)    1076     403>
            , <&key_physical_attrs 100 100    1130     325 (-1000)    1180     375>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_HIGH>
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            ;
    };
};
